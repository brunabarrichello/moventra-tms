# Moventra TMS — contrato de configuração
# NUNCA inserir valores reais neste arquivo.
# Por política, TODAS as atribuições permanecem vazias, inclusive defaults não sensíveis.
# Defaults operacionais são definidos/validados pelo código e documentados abaixo somente em comentários.
# Secrets devem vir do secret store do ambiente (Vercel/Railway/GitHub/serviço aprovado).

# Ambiente / identidade de release
# Defaults locais: NODE_ENV=development; MOVENTRA_ENV=development.
NODE_ENV=
MOVENTRA_ENV=
MOVENTRA_RELEASE_SHA=
APP_VERSION=

# Identificadores não sensíveis de deploy
VERCEL_ORG_ID=
VERCEL_STAGING_PROJECT_ID=
VERCEL_PRODUCTION_PROJECT_ID=

# Secrets — somente nomes de contrato; valores nunca são versionados
VERCEL_TOKEN=
DATABASE_URL=
MESSAGING_RABBITMQ_URL=

# Banco — configuração operacional não sensível
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# Mensageria RabbitMQ / AMQP 0-9-1
# Defaults de código: provider=rabbitmq, exchange=moventra.events, prefetch=20, confirm timeout=5000ms.
# Staging/Production exigem MESSAGING_RABBITMQ_URL com amqps:// (TLS).
MESSAGING_PROVIDER=
MESSAGING_EXCHANGE=
MESSAGING_PREFETCH=
MESSAGING_PUBLISH_CONFIRM_TIMEOUT_MS=

# Jobs — Worker dedicado
# Defaults de código: batch=25, concurrency=5, lease=60000ms, heartbeat=20000ms,
# idle poll=1000ms, idle poll max=5000ms, handler timeout=30000ms,
# retry base=1000ms e retry max=300000ms.
JOBS_BATCH_SIZE=
JOBS_CONCURRENCY=
JOBS_LEASE_MS=
JOBS_HEARTBEAT_MS=
JOBS_IDLE_POLL_MS=
JOBS_IDLE_POLL_MAX_MS=
JOBS_HANDLER_TIMEOUT_MS=
JOBS_RETRY_BASE_MS=
JOBS_RETRY_MAX_MS=

# Transactional Outbox Dispatcher
# Defaults de código: batch=50; claim TTL=60000ms.
OUTBOX_DISPATCH_BATCH_SIZE=
OUTBOX_DISPATCH_CLAIM_TTL_MS=

# Observabilidade OTLP — endpoint/headers podem ser sensíveis conforme o provider.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Fase 026 — DLQ
# Não habilitar/promover variáveis DLQ em Staging/Production enquanto a fase estiver FROZEN.
# Os nomes definitivos permanecem documentados em docs/implementation/026-dlq.md.
