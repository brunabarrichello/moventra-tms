# Moventra TMS — contrato de configuração local/runtime
# NUNCA inserir valores reais neste arquivo.
# Secrets e credenciais reais devem permanecer exclusivamente no secret store do ambiente.

# Ambiente e revision identity
MOVENTRA_ENV=development
MOVENTRA_RELEASE_SHA=
APP_VERSION=

# Identificadores não sensíveis de deploy
VERCEL_ORG_ID=
VERCEL_STAGING_PROJECT_ID=
VERCEL_PRODUCTION_PROJECT_ID=

# Secrets — somente nomes de contrato; valores nunca são versionados
VERCEL_TOKEN=
DATABASE_URL=
MESSAGING_RABBITMQ_URL=

# Banco — configuração operacional não sensível
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# Mensageria RabbitMQ
# Staging/Production exigem amqps:// e credenciais segregadas por ambiente.
MESSAGING_PROVIDER=rabbitmq
MESSAGING_EXCHANGE=moventra.events
MESSAGING_PREFETCH=20
MESSAGING_PUBLISH_CONFIRM_TIMEOUT_MS=5000

# Jobs / worker dedicado
JOBS_BATCH_SIZE=25
JOBS_CONCURRENCY=5
JOBS_LEASE_MS=60000
JOBS_HEARTBEAT_MS=20000
JOBS_IDLE_POLL_MS=1000
JOBS_HANDLER_TIMEOUT_MS=30000
JOBS_RETRY_BASE_MS=1000
JOBS_RETRY_MAX_MS=300000

# Outbox Dispatcher
OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_DISPATCH_CLAIM_TTL_MS=60000
OUTBOX_DISPATCH_IDLE_BACKOFF_BASE_MS=1000
OUTBOX_DISPATCH_IDLE_BACKOFF_MAX_MS=10000

# DLQ — somente parâmetros não sensíveis; ativos quando a capability 026 for habilitada
DLQ_REPROCESS_MAX_ATTEMPTS=5
DLQ_REPROCESS_CLAIM_TTL_MS=60000
DLQ_REPROCESS_BASE_DELAY_MS=1000
DLQ_REPROCESS_MAX_DELAY_MS=300000
DLQ_INGEST_PREFETCH=20
MESSAGING_DLQ_EXCHANGE=moventra.dlx
MESSAGING_DLQ_QUEUE=moventra.dlq
