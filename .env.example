# Moventra TMS — contrato de configuração
# NUNCA inserir valores reais neste arquivo.
# Por política, TODAS as atribuições permanecem vazias, inclusive defaults não sensíveis.
# Defaults operacionais são definidos/validados pelo código e documentados abaixo somente em comentários.
# Secrets devem vir do secret store do ambiente (Vercel/Railway/GitHub/serviço aprovado).

# Ambiente / identidade de release
# Defaults locais: NODE_ENV=development; MOVENTRA_ENV=development.
# Worker dedicado: MOVENTRA_RELEASE_SHA é a identidade canônica da revisão implantada.
# Vercel prebuilt: APP_VERSION é injetado no artefato imutável durante o build.
NODE_ENV=
MOVENTRA_ENV=
MOVENTRA_RELEASE_SHA=
APP_VERSION=

# Identificadores não sensíveis de deploy
# Staging NÃO depende de VERCEL_STAGING_PROJECT_ID estático; o projeto canônico
# moventra-tms-staging é resolvido/convergido dinamicamente pela automação protegida.
VERCEL_ORG_ID=
VERCEL_PRODUCTION_PROJECT_ID=

# Secrets — somente nomes de contrato; valores nunca são versionados
VERCEL_TOKEN=
DATABASE_URL=
MIGRATIONS_DATABASE_URL=
MESSAGING_RABBITMQ_URL=

# Banco — configuração operacional não sensível
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# Autenticação HTTP administrativa — JWT assimétrico provider-neutral e fail-closed.
# Staging/Production recebem issuer/audience/provider/algoritmo, ordem de subject claims,
# JWKS HTTPS e um snapshot PEM público. Contrato atual de subject claims: sub,id.
# Com JWKS configurado, o runtime resolve por kid e tolera rotação sem confiar no snapshot PEM antigo.
# A chave privada NUNCA pertence ao Moventra runtime/repositório e permanece somente no IdP/emissor.
MOVENTRA_AUTH_PROVIDER_KEY=
MOVENTRA_AUTH_JWT_ISSUER=
MOVENTRA_AUTH_JWT_AUDIENCE=
MOVENTRA_AUTH_JWT_ALGORITHM=
MOVENTRA_AUTH_JWT_SUBJECT_CLAIMS=
MOVENTRA_AUTH_JWT_PUBLIC_KEY_PEM=
MOVENTRA_AUTH_JWT_JWKS_URL=

# Mensageria RabbitMQ / AMQP 0-9-1
# Default seguro de código: provider=disabled.
# O Worker dedicado exige provider=rabbitmq e os release gates de Staging/Production
# sincronizam explicitamente MESSAGING_PROVIDER=rabbitmq.
# Defaults quando RabbitMQ está ativo: exchange=moventra.events, prefetch=20,
# confirm timeout=5000ms. Staging/Production exigem MESSAGING_RABBITMQ_URL com amqps:// (TLS).
MESSAGING_PROVIDER=
MESSAGING_EXCHANGE=
MESSAGING_PREFETCH=
MESSAGING_PUBLISH_CONFIRM_TIMEOUT_MS=

# Jobs — Worker dedicado
# Defaults de código: batch=25, concurrency=5, lease=60000ms, heartbeat=20000ms,
# idle poll=1000ms, idle poll max=5000ms, handler timeout=30000ms,
# retry base=1000ms e retry max=300000ms.
JOBS_BATCH_SIZE=
JOBS_CONCURRENCY=
JOBS_LEASE_MS=
JOBS_HEARTBEAT_MS=
JOBS_IDLE_POLL_MS=
JOBS_IDLE_POLL_MAX_MS=
JOBS_HANDLER_TIMEOUT_MS=
JOBS_RETRY_BASE_MS=
JOBS_RETRY_MAX_MS=

# Transactional Outbox Dispatcher
# Defaults de código: batch=50; claim TTL=60000ms.
OUTBOX_DISPATCH_BATCH_SIZE=
OUTBOX_DISPATCH_CLAIM_TTL_MS=

# Fase 026 — DLQ / RabbitMQ ingestion
# Defaults de código: DLX=moventra.dlx, queue=moventra.dlq.ingest, prefetch=10,
# persistence retries=5, retry base=250ms e retry max=5000ms.
# Ativar em Staging/Production somente pelo release gate da fase 026.
DLQ_RABBITMQ_DLX=
DLQ_RABBITMQ_QUEUE=
DLQ_RABBITMQ_PREFETCH=
DLQ_INGEST_PERSIST_RETRIES=
DLQ_INGEST_RETRY_BASE_MS=
DLQ_INGEST_RETRY_MAX_MS=

# Observabilidade OpenTelemetry / OTLP
# OTEL_EXPORTER_OTLP_ENDPOINT ausente => exportação OTLP não é habilitada.
# OTEL_TRACES_EXPORTER / OTEL_METRICS_EXPORTER aceitam seleção governada pelo runtime;
# com endpoint válido e seleção vazia/otlp, o exporter efetivo é otlp; "none" desabilita o sinal.
# OTEL_SDK_DISABLED=true desabilita a inicialização do SDK.
# Endpoint/headers podem ser sensíveis conforme o provider.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_SDK_DISABLED=
