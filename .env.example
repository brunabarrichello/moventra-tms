# Moventra TMS — contrato de configuração
# NUNCA inserir valores reais neste arquivo.
# Secrets devem vir do secret store do ambiente (Vercel/Railway/GitHub/serviço aprovado).

# Ambiente / identidade de release
NODE_ENV=development
MOVENTRA_ENV=development
MOVENTRA_RELEASE_SHA=
APP_VERSION=

# Identificadores não sensíveis de deploy
VERCEL_ORG_ID=
VERCEL_STAGING_PROJECT_ID=
VERCEL_PRODUCTION_PROJECT_ID=

# Secrets — somente nomes de contrato; valores nunca são versionados
VERCEL_TOKEN=
DATABASE_URL=
MESSAGING_RABBITMQ_URL=

# Banco — configuração operacional não sensível
DB_POOL_MAX=
DB_POOL_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# Mensageria RabbitMQ / AMQP 0-9-1
# Staging/Production exigem MESSAGING_RABBITMQ_URL com amqps:// (TLS).
MESSAGING_PROVIDER=rabbitmq
MESSAGING_EXCHANGE=moventra.events
MESSAGING_PREFETCH=20
MESSAGING_PUBLISH_CONFIRM_TIMEOUT_MS=5000

# Jobs — Worker dedicado
JOBS_BATCH_SIZE=25
JOBS_CONCURRENCY=5
JOBS_LEASE_MS=60000
JOBS_HEARTBEAT_MS=20000
JOBS_IDLE_POLL_MS=1000
JOBS_IDLE_POLL_MAX_MS=5000
JOBS_HANDLER_TIMEOUT_MS=30000
JOBS_RETRY_BASE_MS=1000
JOBS_RETRY_MAX_MS=300000

# Transactional Outbox Dispatcher
OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_DISPATCH_CLAIM_TTL_MS=60000

# Observabilidade OTLP — endpoint/headers podem ser sensíveis conforme o provider.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Fase 026 — DLQ
# Não habilitar/promover variáveis DLQ em Staging/Production enquanto a fase estiver FROZEN.
# Os nomes definitivos permanecem documentados em docs/implementation/026-dlq.md.
